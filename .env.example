# Корневой домен платформы. Каждое агентство получает {slug}.{ROOT_DOMAIN}
NEXT_PUBLIC_ROOT_DOMAIN=orbisystem.us

# Ключ подписи сессии (вход, приглашения). Без своего значения сервер
# подписывает куки предсказуемым ключом — задайте случайную строку
# (например, `openssl rand -hex 32`) перед реальным запуском.
SESSION_SECRET=

# Файл SQLite для реальных агентств/сотрудников (регистрация и приглашения).
# По умолчанию — data/orbis.sqlite рядом с проектом.
ORBIS_DB_PATH=

# ── Приложение Meta: приём лидов из рекламы ──────────────────────
# Создаётся на developers.facebook.com, сценарий «Получение рекламных
# лидов». Секрет приложения — пароль: он живёт только здесь, в файле
# окружения, и в репозиторий не попадает.
META_APP_ID=
META_APP_SECRET=

# Слово, которым Meta подтверждает адрес вебхука. Любая случайная строка;
# то же значение вписывается в кабинете Meta рядом с адресом
# https://{ROOT_DOMAIN}/api/meta/webhook
META_VERIFY_TOKEN=

# Адрес возврата после входа в Facebook. Обязан совпадать до символа с тем,
# что вписан в настройках приложения Meta. По умолчанию —
# https://{ROOT_DOMAIN}/api/meta/connect
META_REDIRECT_URI=
