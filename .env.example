# Корневой домен платформы. Каждое агентство получает {slug}.{ROOT_DOMAIN}
NEXT_PUBLIC_ROOT_DOMAIN=orbisystem.us

# Ключ подписи сессии (вход, приглашения). Без своего значения сервер
# подписывает куки предсказуемым ключом — задайте случайную строку
# (например, `openssl rand -hex 32`) перед реальным запуском.
SESSION_SECRET=

# Файл SQLite для реальных агентств/сотрудников (регистрация и приглашения).
# По умолчанию — data/orbis.sqlite рядом с проектом.
ORBIS_DB_PATH=
